{
  "multipart": [
    {
      "apply": {
        "model": "buildcraftreforged:block/frame_block"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "buildcraftreforged:block/frame_block_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "buildcraftreforged:block/frame_block_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "buildcraftreforged:block/frame_block_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "buildcraftreforged:block/frame_block_east"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "buildcraftreforged:block/frame_block_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "buildcraftreforged:block/frame_block_up"
      }
    }
  ]
}
